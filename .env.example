# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production

# Frontend Configuration (used by Vite)
VITE_API_URL=http://localhost:5000/api

# Reddit API Configuration
# Get credentials from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token
REDDIT_USER_AGENT=AlphaSeek Stock Idea Scraper v1.0

# Twitter API Configuration
# Get Bearer Token from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ValueInvestorsClub Configuration (Optional - requires membership)
# Sign up at: https://www.valueinvestorsclub.com/
VIC_USERNAME=your-vic-username
VIC_PASSWORD=your-vic-password
